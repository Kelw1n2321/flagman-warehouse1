  },
  "Monitor": {
    "IntervalSeconds": 30
  },
  "Auth": {
    "AdminIds": ""
  },
  "Demo": {
    "AllowReset": true,
    "SeedOnStart": true
  },
  "Urls": "http://localhost:5080"
}
